# ==============================================================================
# DROPCLOCK PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# ==============================================================================
# Use this template for production deployment on Railway, Fly.io, Render, or AWS.
# IMPORTANT: Never commit actual secret keys or credentials to public source control.
# ==============================================================================

# Node Environment Mode
NODE_ENV=production

# Shopify App Credentials (Obtained from Shopify Partners Dashboard > Apps > DropClock)
SHOPIFY_API_KEY=your_production_shopify_api_key_here
SHOPIFY_API_SECRET=your_production_shopify_api_secret_here

# Public Production URL (Strict HTTPS domain with ZERO trailing slash)
# Example: https://dropclock-production.up.railway.app
SHOPIFY_APP_URL=https://dropclock.yourdomain.com

# Access Scopes (Strict minimal scopes - Zero Protected Customer Data)
SCOPES=read_products,write_products

# Managed PostgreSQL Connection String
# For pooled production connections (e.g. Supabase, Neon, AWS RDS, Railway PostgreSQL):
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&pgbouncer=true
DATABASE_URL=postgresql://postgres:your_secure_password@your-db-host.region.rds.amazonaws.com:5432/dropclock?schema=public&sslmode=require

# Application Server Port (Defaults to 3000 or platform-injected $PORT)
PORT=3000
