datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  @@index([shop])
}

model DropClockSettings {
  id              String   @id @default(uuid())
  shop            String   @unique
  cutoffHour      Int      @default(14)
  cutoffMinute    Int      @default(0)
  leadDays        Int      @default(2)
  workingDays     String   @default("[1,2,3,4,5]") @db.Text
  widgetStyle     String   @default("capsule")     // "capsule" | "urgency" | "minimal"
  accentColor     String   @default("#008060")
  cardBg          String   @default("#F4F6F8")
  textColor       String   @default("#202223")
  blackoutDates   String   @default("[]")          @db.Text
  tagRules        String   @default("[]")          @db.Text
  translations    String   @default("{}")          @db.Text
  presetStyle     String?  @default("capsule")
  primaryColor    String?  @default("#008060")
  bgColor         String?  @default("#F4F6F8")
  tagRulesJson    String?  @default("[]")          @db.Text
  leadText        String?  @default("Order within")
  sameDayText     String?  @default("for same-day dispatch")
  nextDayText     String?  @default("for tomorrow's dispatch")
  etaText         String?  @default("Estimated Delivery:")
  enableTagRules  Boolean  @default(true)
  marketOverrides String   @default("{}")          @db.Text
  isActive        Boolean  @default(true)
  uninstalledAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shop])
}
