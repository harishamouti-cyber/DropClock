{% comment %}
  DropClock - 21ST.DEV / SHADCN DTC Shipping Cutoff & Arrival ETA Capsule
  Reads shop settings directly from Metafields for 0ms blocking time & CLS defense.
{% endcomment %}

{% assign config = shop.metafields.dropclock.settings.value %}
{% assign base_cutoff_hour = config.cutoffHour | default: 14 %}
{% assign base_cutoff_minute = config.cutoffMinute | default: 0 %}
{% assign base_lead_days = config.leadDays | default: 2 %}
{% assign working_days = config.workingDays | default: "[1,2,3,4,5]" %}
{% assign blackout_dates = config.blackoutDates | default: "[]" %}
{% assign market_overrides = config.marketOverrides | default: "{}" %}
{% assign tz_offset = config.timezoneOffsetMinutes | default: 0 %}
{% assign iana_tz = config.ianaTimezone | default: 'UTC' %}
{% assign trans = config.translations %}
{% assign lead_text = trans.cutoffPrefix | default: config.leadText | default: 'Order within' %}
{% assign sameday_text = trans.sameDaySuffix | default: config.sameDayText | default: 'for same-day dispatch' %}
{% assign nextday_text = trans.nextDaySuffix | default: config.nextDayText | default: "for tomorrow's dispatch" %}
{% assign eta_text = trans.deliveryPrefix | default: config.etaText | default: 'Estimated Delivery:' %}
{% assign active_style = block.settings.style_preset | default: config.widgetStyle | default: config.presetStyle | default: 'capsule' %}
{% if active_style == 'bar' %}{% assign active_style = 'urgency' %}{% endif %}

{% comment %} Tag Rule Overrides {% endcomment %}
{% assign active_cutoff_hour = base_cutoff_hour %}
{% assign active_cutoff_minute = base_cutoff_minute %}
{% assign effective_lead_days = config.leadDays | default: 2 %}
{% assign rules = config.tagRules | default: config.tagRulesJson %}

{% if rules %}
  {% for rule in rules %}
    {% if product.tags contains rule.tag %}
      {% assign effective_lead_days = rule.leadDays %}
      {% if rule.cutoffHour %}{% assign active_cutoff_hour = rule.cutoffHour %}{% endif %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% assign current_country = localization.country.iso_code %}
{% assign is_available = product.selected_or_first_available_variant.available %}

<div 
  class="dropclock-widget-root dc-w"
  id="dropclock-{{ block.id }}"
  data-cutoff-hour="{{ active_cutoff_hour }}"
  data-cutoff-min="{{ active_cutoff_minute }}"
  data-cutoff-minute="{{ active_cutoff_minute }}"
  data-lead-days="{{ effective_lead_days }}"
  data-working-days='{{ working_days }}'
  data-blackout-dates="{{ config.blackoutDates | json | escape }}"
  data-blackouts='{{ blackout_dates }}'
  data-market-overrides='{{ market_overrides }}'
  data-timezone-offset="{{ tz_offset }}"
  data-tz-offset="{{ tz_offset }}"
  data-iana-tz="{{ iana_tz }}"
  data-current-country="{{ current_country }}"
  data-available="{{ is_available }}"
  data-widget-style="{{ active_style }}"
  data-translations='{{ trans | json | escape }}'
  data-lead-text="{{ lead_text | escape }}"
  data-sameday-text="{{ sameday_text | escape }}"
  data-nextday-text="{{ nextday_text | escape }}"
  data-eta-text="{{ eta_text | escape }}"
  style="
    --dc-primary: {{ block.settings.primary_color | default: config.accentColor | default: config.primaryColor | default: '#008060' }};
    --dc-bg: {{ block.settings.bg_color | default: config.cardBg | default: config.bgColor | default: '#f8fafc' }};
    --dc-text: {{ block.settings.text_color | default: config.textColor | default: '#0f172a' }};
    --dc-radius: {{ block.settings.corner_radius | default: 12 }}px;
    min-height: 48px;
    width: 100%;
    margin: 14px 0;
  "
>
  <div 
    class="dc-pill-card {{ active_style }}" 
    style="display: {% if is_available %}flex{% else %}none{% endif %};"
  >
    <div class="dc-primary-row">
      <div class="dc-pulse-indicator">
        <span class="dc-ping"></span>
        <span class="dc-dot"></span>
      </div>
      <div class="dc-text-wrap">
        <span class="dc-label">{{ lead_text }}</span>
        <span class="dc-timer-val" data-dc-timer>--h --m --s</span>
        <span class="dc-subtext" data-dc-subtext>{{ sameday_text }}</span>
      </div>
    </div>
    
    {% if active_style == 'urgency' %}
      <div class="dc-bar-track">
        <div class="dc-bar-fill" data-dc-bar-fill style="width: 100%;"></div>
      </div>
    {% endif %}

    <div class="dc-secondary-row">
      <svg class="dc-truck-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="15" height="13"></rect>
        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
        <circle cx="5.5" cy="18.5" r="2.5"></circle>
        <circle cx="18.5" cy="18.5" r="2.5"></circle>
      </svg>
      <span class="dc-eta-label">{{ eta_text }}</span>
      <span class="dc-eta-date" data-dc-eta>Calculating...</span>
    </div>
  </div>

  <div 
    class="dc-backorder-notice" 
    style="display: {% if is_available %}none{% else %}flex{% endif %};"
  >
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span>Backorder Item: Ships as soon as restocked.</span>
  </div>
</div>

<style>
  .dropclock-widget-root {
    contain: layout;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .dc-pill-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px 14px;
    background: var(--dc-bg);
    border: 1px solid #e2e8f0;
    border-radius: var(--dc-radius);
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
    color: var(--dc-text);
    transition: all 0.2s ease;
  }
  .dc-primary-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    line-height: 1.4;
  }
  .dc-pulse-indicator {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 10px;
    height: 10px;
    flex-shrink: 0;
  }
  .dc-ping {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 9999px;
    background-color: var(--dc-primary);
    opacity: 0.6;
    animation: dc-ping-anim 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  .dc-dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background-color: var(--dc-primary);
  }
  .dc-text-wrap {
    display: flex;
    align-items: baseline;
    gap: 4px;
    flex-wrap: wrap;
  }
  .dc-label {
    color: #475569;
    font-weight: 450;
  }
  .dc-timer-val {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    color: var(--dc-primary);
    letter-spacing: -0.02em;
  }
  .dc-subtext {
    color: #475569;
    font-weight: 450;
  }
  .dc-bar-track {
    width: 100%;
    height: 4px;
    background: rgba(0,0,0,0.06);
    border-radius: 9999px;
    overflow: hidden;
    margin: 2px 0;
  }
  .dc-bar-fill {
    height: 100%;
    background-color: var(--dc-primary);
    border-radius: 9999px;
    transition: width 0.5s ease;
  }
  .dc-secondary-row {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #64748b;
    padding-top: 4px;
    border-top: 1px solid #f1f5f9;
  }
  .dc-truck-icon {
    width: 13px;
    height: 13px;
    stroke: #64748b;
    flex-shrink: 0;
  }
  .dc-eta-label {
    font-weight: 450;
  }
  .dc-eta-date {
    font-weight: 600;
    color: #1e293b;
  }
  .dc-backorder-notice {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    font-size: 12px;
    background: #fff8e5;
    color: #8a6100;
    border: 1px solid #e6c280;
    border-radius: var(--dc-radius);
    min-height: 44px;
  }
  @keyframes dc-ping-anim {
    75%, 100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }
  @media (max-width: 380px) {
    .dc-primary-row, .dc-secondary-row {
      font-size: 11.5px;
    }
  }
</style>

<script>
(function() {
  function init() {
    var root = document.getElementById("dropclock-{{ block.id }}");
    if (!root) return;
    var ds = root.dataset || {};
    var cardEl = root.querySelector(".dc-pill-card");
    var backorderEl = root.querySelector(".dc-backorder-notice");
    var timerValEl = root.querySelector("[data-dc-timer]");
    var subtextEl = root.querySelector("[data-dc-subtext]");
    var etaDateEl = root.querySelector("[data-dc-eta]");
    var barFillEl = root.querySelector("[data-dc-bar-fill]");

    var cutoffH = ds.cutoffHour != null ? +ds.cutoffHour : 14;
    var cutoffM = +(ds.cutoffMin || ds.cutoffMinute || 0);
    var leadDays = +ds.leadDays || 2;
    var tzOffset = +(ds.timezoneOffset || ds.tzOffset || 0);
    var samedayText = ds.samedayText || "for same-day dispatch";
    var nextdayText = ds.nextdayText || "for tomorrow's dispatch";

    function safeParse(str) {
      try { return JSON.parse(str); } catch(e) { return null; }
    }

    var workingDays = safeParse(ds.workingDays);
    var blackoutDates = safeParse(ds.blackoutDates || ds.blackouts);
    var marketOverrides = safeParse(ds.marketOverrides) || {};

    if (!Array.isArray(workingDays) || !workingDays.length) {
      workingDays = [1, 2, 3, 4, 5];
    }
    if (!Array.isArray(blackoutDates)) {
      blackoutDates = [];
    }

    if (ds.currentCountry && marketOverrides[ds.currentCountry]) {
      leadDays += +marketOverrides[ds.currentCountry] || 0;
    }

    function tick() {
      if (ds.available === "false") return;

      var now = new Date(Date.now() + tzOffset * 60 * 1000);
      var currentSecs = now.getUTCHours() * 3600 + now.getUTCMinutes() * 60 + now.getUTCSeconds();
      var cutoffSecs = cutoffH * 3600 + cutoffM * 60;
      var diffSecs = cutoffSecs - currentSecs;
      var isPastCutoff = diffSecs <= 0;

      if (isPastCutoff) {
        diffSecs += 86400;
      }

      var h = Math.floor(diffSecs / 3600);
      var m = Math.floor((diffSecs % 3600) / 60);
      var s = Math.floor(diffSecs % 60);

      if (timerValEl) {
        timerValEl.textContent = h + "h " + (m < 10 ? "0" + m : m) + "m " + (s < 10 ? "0" + s : s) + "s";
      }

      if (subtextEl) {
        subtextEl.textContent = isPastCutoff ? nextdayText : samedayText;
      }

      if (barFillEl) {
        var startSecs = 8 * 3600; // 8:00 AM
        var windowSecs = cutoffSecs > startSecs ? cutoffSecs - startSecs : 14400;
        var pct = isPastCutoff ? 0 : Math.max(5, Math.min(100, Math.round((diffSecs / windowSecs) * 100)));
        barFillEl.style.width = pct + "%";
      }

      // Calculate Delivery Arrival Date
      var delivery = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
      if (isPastCutoff) {
        delivery.setUTCDate(delivery.getUTCDate() + 1);
      }

      var transitLeft = leadDays;
      while (transitLeft > 0 || workingDays.indexOf(delivery.getUTCDay()) === -1 || blackoutDates.indexOf(delivery.toISOString().split("T")[0]) !== -1) {
        delivery.setUTCDate(delivery.getUTCDate() + 1);
        if (workingDays.indexOf(delivery.getUTCDay()) !== -1 && blackoutDates.indexOf(delivery.toISOString().split("T")[0]) === -1) {
          if (transitLeft > 0) transitLeft--;
        }
      }

      if (etaDateEl) {
        etaDateEl.textContent = delivery.toLocaleDateString(undefined, {
          timeZone: "UTC",
          weekday: "short",
          month: "short",
          day: "numeric"
        });
      }
    }

    function setStockState(isAvailable) {
      ds.available = isAvailable ? "true" : "false";
      root.setAttribute("data-available", ds.available);
      if (cardEl) cardEl.style.display = isAvailable ? "flex" : "none";
      if (backorderEl) backorderEl.style.display = isAvailable ? "none" : "flex";
      if (isAvailable) tick();
    }

    function listen(evtName, fn) {
      document.addEventListener(evtName, fn);
    }

    listen("variant:change", function(e) {
      var v = e && e.detail && (e.detail.variant || e.detail);
      if (v && v.available != null) setStockState(Boolean(v.available));
    });

    listen("change", function(e) {
      var form = e.target.form || e.target.closest("form") || document.querySelector("form[action*='/cart/add']");
      if (form) {
        setTimeout(function() {
          var submitBtn = form.querySelector('[name="add"], .product-form__submit');
          if (submitBtn) {
            setStockState(!(submitBtn.disabled || /sold|unavail/i.test(submitBtn.textContent || "")));
          }
        }, 50);
      }
    });

    tick();
    setInterval(tick, 1000);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>

{% schema %}
{
  "name": "DropClock Delivery ETA",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "style_preset",
      "label": "Display Style",
      "options": [
        { "value": "capsule", "label": "21st.dev DTC Micro-Card (Recommended)" },
        { "value": "urgency", "label": "Urgency Highlight Bar" },
        { "value": "minimal", "label": "Minimal Text Line" }
      ],
      "default": "capsule"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Accent / Countdown Color",
      "default": "#008060"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Card Color",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Primary Text Color",
      "default": "#0f172a"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Border Radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "font_scale",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 13
    },
    {
      "type": "range",
      "id": "margin_y",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Vertical Spacing",
      "default": 14
    }
  ]
}
{% endschema %}
