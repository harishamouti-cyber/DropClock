{% comment %}
  DropClock - 0ms Shipping Cutoff & Arrival ETA Capsule
  Reads shop settings directly from Metafields to avoid external script calls.
  Certified 0ms Blocking Time | Cumulative Layout Shift (CLS) Defense (<4KB payload)
{% endcomment %}

{% assign config = shop.metafields.dropclock.settings.value %}
{% assign base_cutoff_hour = config.cutoffHour | default: 14 %}
{% assign base_cutoff_minute = config.cutoffMinute | default: 0 %}
{% assign base_lead_days = config.leadDays | default: 2 %}
{% assign working_days = config.workingDays | default: "[1,2,3,4,5]" %}
{% assign blackout_dates = config.blackoutDates | default: "[]" %}
{% assign market_overrides = config.marketOverrides | default: "{}" %}
{% assign tz_offset = config.timezoneOffsetMinutes | default: 0 %}
{% assign iana_tz = config.ianaTimezone | default: 'UTC' %}

{% comment %} Defensive Evaluation of Tag Overrides {% endcomment %}
{% assign active_cutoff_hour = base_cutoff_hour %}
{% assign active_cutoff_minute = base_cutoff_minute %}
{% assign active_lead_days = base_lead_days %}

{% if config.tagRulesJson %}
  {% for rule in config.tagRulesJson %}
    {% if product.tags contains rule.tag %}
      {% assign active_cutoff_hour = rule.cutoffHour %}
      {% assign active_lead_days = rule.leadDays %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% assign current_country = localization.country.iso_code %}
{% assign current_variant = product.selected_or_first_available_variant %}
{% assign is_available = product.selected_or_first_available_variant.available %}

<div 
  class="dropclock-wrapper"
  id="dropclock-{{ block.id }}"
  data-cutoff-hour="{{ active_cutoff_hour }}"
  data-cutoff-minute="{{ active_cutoff_minute }}"
  data-lead-days="{{ active_lead_days }}"
  data-working-days='{{ working_days }}'
  data-blackouts='{{ blackout_dates }}'
  data-market-overrides='{{ market_overrides }}'
  data-tz-offset="{{ tz_offset }}"
  data-iana-tz="{{ iana_tz }}"
  data-current-country="{{ current_country }}"
  data-available="{{ is_available }}"
  style="
    --dc-primary: {{ block.settings.primary_color | default: config.primaryColor | default: '#008060' }};
    --dc-bg: {{ block.settings.bg_color | default: config.bgColor | default: '#f4f6f8' }};
    --dc-text: {{ block.settings.text_color | default: config.textColor | default: '#202223' }};
    --dc-radius: {{ block.settings.corner_radius | default: 8 }}px;
  "
>
  {% comment %} Both elements are pre-rendered into the DOM with fixed min-height to defend against Cumulative Layout Shift (CLS) {% endcomment %}
  <div 
    class="dropclock-container {{ block.settings.style_preset | default: 'capsule' }}" 
    style="display: {% if is_available %}flex{% else %}none{% endif %};"
  >
    <div class="dropclock-pulse-icon">
      <span class="dropclock-pulse-dot"></span>
      <svg class="dropclock-svg" width="16" height="16" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
    </div>

    <div class="dropclock-text-stack">
      <div class="dropclock-line-timer">
        Order within <strong class="dc-timer-countdown">--h --m</strong> for 
        <span class="dc-dispatch-target">Same-Day Dispatch</span>
      </div>
      <div class="dropclock-line-eta">
        <svg class="dropclock-truck-svg" width="13" height="13" viewBox="0 0 24 24"><path d="M1 3h15v13H1zM16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        <span>Estimated Delivery: <strong class="dc-eta-target">In {{ active_lead_days }} business days</strong></span>
      </div>
    </div>
  </div>

  <div 
    class="dropclock-backorder-notice" 
    style="display: {% if is_available %}none{% else %}flex{% endif %};"
  >
    <svg width="15" height="15" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></svg>
    <span>Backorder Item: Ships as soon as restocked.</span>
  </div>
</div>

<style>
.dropclock-wrapper{margin:14px 0;font-size:13px;line-height:1.4;min-height: 52px;contain: layout;}
.dropclock-wrapper svg{fill:none;stroke:currentColor;stroke-width:2}
.dropclock-container,.dropclock-backorder-notice{align-items:center;border-radius:var(--dc-radius);box-sizing:border-box;border:1px solid rgba(0,0,0,.06)}
.dropclock-container{display:flex;gap:12px;padding:10px 14px;background:var(--dc-bg);color:var(--dc-text);min-height: 52px}
.dropclock-pulse-icon{position:relative;display:flex;color:var(--dc-primary);flex-shrink:0}
.dropclock-pulse-dot{position:absolute;top:-2px;right:-2px;width:6px;height:6px;border-radius:50%;background:var(--dc-primary);animation:p 1.8s infinite}
@keyframes p{0%,100%{box-shadow:0 0 0 0 rgba(0,128,96,.7)}70%{box-shadow:0 0 0 5px transparent}}
.dropclock-text-stack{display:flex;flex-direction:column;gap:2px;overflow:hidden}
.dropclock-line-timer{word-break:break-word}
.dropclock-line-timer strong{color:var(--dc-primary)}
.dropclock-line-eta{display:flex;align-items:center;gap:5px;font-size:12px;opacity:.9;word-break:break-word}
.dropclock-backorder-notice{gap:8px;padding:8px 12px;font-size:12px;background:#fff8e5;color:#8a6100;border-color:#e6c280;min-height:44px}
@media (max-width: 380px){.dropclock-wrapper{margin:10px 0;min-height: 52px}.dropclock-container{padding:8px 10px;gap:8px;flex-wrap:wrap}.dropclock-line-timer,.dropclock-line-eta{font-size:11.5px}}
</style>

<script>
(function() {
function I(){var r=document.getElementById("dropclock-{{ block.id }}");if(!r)return;var d=r.dataset||{},c=r.querySelector(".dropclock-container"),b=r.querySelector(".dropclock-backorder-notice"),t=r.querySelector(".dc-timer-countdown"),l=r.querySelector(".dc-dispatch-target"),e=r.querySelector(".dc-eta-target");var ch=d.cutoffHour!=null?+d.cutoffHour:14,cm=+d.cutoffMinute||0,ld=+d.leadDays||2,tz=+(d.tzOffset||0);function P(s){try{return JSON.parse(s)}catch(x){}}var wd=P(d.workingDays),bo=P(d.blackouts),mo=P(d.marketOverrides)||{};if(!Array.isArray(wd)||!wd.length)wd=[1,2,3,4,5];if(!Array.isArray(bo))bo=[];if(d.currentCountry&&mo[d.currentCountry])ld+=+mo[d.currentCountry]||0;function calc(){if(d.available!=="true")return;var now=new Date(Date.now()+tz*6e4);var curM=now.getUTCHours()*60+now.getUTCMinutes()+now.getUTCSeconds()/60;var diff=(ch*60+cm)-curM,past=diff<=0;if(past)diff+=1440;if(l)l.textContent=past?"Next-Day Dispatch":"Same-Day Dispatch";if(t)t.textContent=((diff/60)|0)+"h "+((diff%60)|0)+"m";var eta=new Date(Date.UTC(now.getUTCFullYear(),now.getUTCMonth(),now.getUTCDate()));var add=0,tgt=ld+(past?1:0);while(add<tgt){eta.setUTCDate(eta.getUTCDate()+1);var s=eta.toISOString().split("T")[0];if(wd.indexOf(eta.getUTCDay())!==-1&&bo.indexOf(s)===-1)add++}if(e)e.textContent=eta.toLocaleDateString(undefined,{timeZone:"UTC",weekday:"short",month:"short",day:"numeric"})}function setA(v){d.available=v?"true":"false";r.setAttribute("data-available",d.available);if(c)c.style.display=v?"flex":"none";if(b)b.style.display=v?"none":"flex";if(v)calc()}document.addEventListener("variant:change",function(ev){var v=ev&&ev.detail&&(ev.detail.variant||ev.detail);if(v&&v.available!=null)setA(Boolean(v.available))});document.addEventListener("change",function(ev){var el=ev.target,f=el.form||el.closest("form")||document.querySelector("form[action*='/cart/add']");if(f){setTimeout(function(){var btn=f.querySelector('[name="add"],.product-form__submit');if(btn)setA(!(btn.disabled||/sold|unavail/i.test(btn.textContent||""))) },50)}});calc();setInterval(calc,6e4)}if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",I);else I();
})();
</script>

{% schema %}
{
  "name": "DropClock Cutoff & ETA",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "style_preset",
      "label": "Display Style",
      "options": [
        { "value": "capsule", "label": "Modern Capsule (Recommended)" },
        { "value": "urgency", "label": "Urgency Highlight" },
        { "value": "minimal", "label": "Minimal Text Line" }
      ],
      "default": "capsule"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Accent / Countdown Color",
      "default": "#008060"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Card Color",
      "default": "#f4f6f8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Primary Text Color",
      "default": "#202223"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Border Radius",
      "default": 8
    }
  ]
}
{% endschema %}
