{% comment %}
  DropClock - 0ms Shipping Cutoff & Arrival ETA Capsule
  Reads shop settings directly from Metafields to avoid external script calls.
  Certified 0ms Blocking Time | Cumulative Layout Shift (CLS) Defense (<4KB payload)
{% endcomment %}

{% assign config = shop.metafields.dropclock.settings.value %}
{% assign base_cutoff_hour = config.cutoffHour | default: 14 %}
{% assign base_cutoff_minute = config.cutoffMinute | default: 0 %}
{% assign base_lead_days = config.leadDays | default: 2 %}
{% assign working_days = config.workingDays | default: "[1,2,3,4,5]" %}
{% assign blackout_dates = config.blackoutDates | default: "[]" %}
{% assign market_overrides = config.marketOverrides | default: "{}" %}
{% assign tz_offset = config.timezoneOffsetMinutes | default: 0 %}
{% assign iana_tz = config.ianaTimezone | default: 'UTC' %}
{% assign lead_text = config.leadText | default: 'Order within' %}
{% assign sameday_text = config.sameDayText | default: 'for same-day dispatch' %}
{% assign nextday_text = config.nextDayText | default: "for tomorrow's dispatch" %}
{% assign eta_text = config.etaText | default: 'Estimated Delivery:' %}
{% assign active_style = block.settings.style_preset | default: config.presetStyle | default: 'capsule' %}
{% if active_style == 'bar' %}{% assign active_style = 'urgency' %}{% endif %}

{% comment %} Defensive Evaluation of Tag Overrides {% endcomment %}
{% assign active_cutoff_hour = base_cutoff_hour %}
{% assign active_cutoff_minute = base_cutoff_minute %}
{% assign effective_lead_days = config.leadDays | default: 2 %}
{% assign rules = config.tagRules | default: config.tagRulesJson %}

{% if rules %}
  {% for rule in rules %}
    {% if product.tags contains rule.tag %}
      {% assign effective_lead_days = rule.leadDays %}
      {% if rule.cutoffHour %}{% assign active_cutoff_hour = rule.cutoffHour %}{% endif %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% assign current_country = localization.country.iso_code %}
{% assign current_variant = product.selected_or_first_available_variant %}
{% assign is_available = product.selected_or_first_available_variant.available %}

<div 
  class="dropclock-wrapper dc-w"
  id="dropclock-{{ block.id }}"
  data-cutoff-hour="{{ active_cutoff_hour }}"
  data-cutoff-minute="{{ active_cutoff_minute }}"
  data-lead-days="{{ effective_lead_days }}"
  data-working-days='{{ working_days }}'
  data-blackout-dates="{{ config.blackoutDates | json | escape }}"
  data-blackouts='{{ blackout_dates }}'
  data-market-overrides='{{ market_overrides }}'
  data-tz-offset="{{ tz_offset }}"
  data-iana-tz="{{ iana_tz }}"
  data-current-country="{{ current_country }}"
  data-available="{{ is_available }}"
  data-widget-style="{{ active_style }}"
  data-lead-text="{{ lead_text | escape }}"
  data-sameday-text="{{ sameday_text | escape }}"
  data-nextday-text="{{ nextday_text | escape }}"
  data-eta-text="{{ eta_text | escape }}"
  style="
    --dc-primary: {{ block.settings.primary_color | default: config.primaryColor | default: '#008060' }};
    --dc-bg: {{ block.settings.bg_color | default: config.bgColor | default: '#f4f6f8' }};
    --dc-text: {{ block.settings.text_color | default: config.textColor | default: '#202223' }};
    --dc-radius: {{ block.settings.corner_radius | default: 8 }}px;
  "
>
  {% comment %} Both elements are pre-rendered into the DOM with fixed min-height to defend against Cumulative Layout Shift (CLS) {% endcomment %}
  <div 
    class="dropclock-container dc-c {{ active_style }}" 
    style="display: {% if is_available %}flex{% else %}none{% endif %};"
  >
    <div class="dropclock-pulse-icon dc-p">
      <span class="dropclock-pulse-dot dc-d"></span>
      <svg width="16" height="16" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
    </div>

    <div class="dropclock-text-stack dc-s">
      <div class="dropclock-line-timer dc-t">
        <span>{{ lead_text }}</span> <strong class="dc-timer-countdown dc-tc">--h --m</strong> <span class="dc-dispatch-target dc-dt">{{ sameday_text }}</span>
      </div>
      <div class="dc-bar">
        <div class="dc-bf" style="width:100%"><span class="dc-bp"></span></div>
      </div>
      <div class="dropclock-line-eta dc-e">
        <svg width="13" height="13" viewBox="0 0 24 24"><path d="M1 3h15v13H1zM16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        <span><span>{{ eta_text }}</span> <strong class="dc-eta-target dc-et">In {{ effective_lead_days }} business days</strong></span>
      </div>
    </div>
  </div>

  <div 
    class="dropclock-backorder-notice dc-b" 
    style="display: {% if is_available %}none{% else %}flex{% endif %};"
  >
    <svg width="15" height="15" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></svg>
    <span>Backorder Item: Ships as soon as restocked.</span>
  </div>
</div>

<style>
.dropclock-wrapper{margin:14px 0;font-size:13px;line-height:1.4;min-height: 52px;contain: layout;}
.dc-w svg{fill:none;stroke:currentColor;stroke-width:2}
.dc-c,.dc-b{display:flex;align-items:center;border-radius:var(--dc-radius);box-sizing:border-box;border:1px solid #0000000f}
.dropclock-container{gap:12px;padding:10px 14px;background:var(--dc-bg);color:var(--dc-text)}
.dc-p{position:relative;display:flex;flex-shrink:0}
.dc-t strong,.dc-p{color:var(--dc-primary)}
.dc-d,.dc-bp{position:absolute;width:6px;height:6px;border-radius:50%;background:var(--dc-primary);animation:p 1.8s infinite}
.dc-d{top:-2px;right:-2px}
.dc-bp{display:none;top:-1px;right:-2px}
.dc-urgent .dc-bp{display:block}
@keyframes p{0%,to{box-shadow:0 0 #008060b3}70%{box-shadow:0 0 0 5px #0000}}
.dc-s{display:flex;flex-direction:column;gap:2px;overflow:hidden;flex:1}
.dc-t,.dc-e{word-break:break-word}
.dc-e{display:flex;align-items:center;gap:5px;font-size:12px;opacity:.9}
.dc-bar{display:none;width:100%;height:4px;background:#0000000f;border-radius:99px;position:relative;margin:3px 0}
[data-widget-style="urgency"] .dc-bar,.urgency .dc-bar{display:block}
.dc-bf{height:100%;background:var(--dc-primary);border-radius:99px;position:relative;transition:width .4s}
.dc-b{gap:8px;padding:8px 12px;font-size:12px;background:#fff8e5;color:#8a6100;border-color:#e6c280;min-height:44px}
@media (max-width: 380px){.dropclock-wrapper{margin:10px 0;min-height: 52px}.dropclock-container{padding:8px 10px;gap:8px;flex-wrap:wrap}.dc-t,.dc-e{font-size:11.5px}}
</style>

