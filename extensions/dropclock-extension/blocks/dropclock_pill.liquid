</script>

{% schema %}
{
  "name": "DropClock Cutoff & ETA",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "style_preset",
      "label": "Display Style",
      "options": [
        { "value": "capsule", "label": "Modern Capsule (Recommended)" },
        { "value": "urgency", "label": "Urgency Highlight" },
        { "value": "minimal", "label": "Minimal Text Line" }
      ],
      "default": "capsule"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Accent / Countdown Color",
      "default": "#008060"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Card Color",
      "default": "#f4f6f8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Primary Text Color",
      "default": "#202223"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Border Radius",
      "default": 8
    }
  ]
}
{% endschema %}
