{% comment %}
  DropClock - 21ST.DEV / SHADCN DTC Shipping Cutoff & Arrival ETA Capsule
  Reads shop settings directly from Metafields for 0ms blocking time & CLS defense.
{% endcomment %}

{% assign config = shop.metafields.dropclock.settings.value %}
{% assign base_cutoff_hour = config.cutoffHour | default: 14 %}
{% assign base_cutoff_minute = config.cutoffMinute | default: 0 %}
{% assign tz_offset = config.timezoneOffsetMinutes | default: 0 %}
{% assign iana_tz = config.ianaTimezone | default: 'UTC' %}
{% assign trans = config.translations %}
{% assign lead_text = trans.cutoffPrefix | default: config.leadText | default: 'Order within' %}
{% assign sameday_text = trans.sameDaySuffix | default: config.sameDayText | default: 'for same-day dispatch' %}
{% assign nextday_text = trans.nextDaySuffix | default: config.nextDayText | default: "for tomorrow's dispatch" %}
{% assign eta_text = trans.deliveryPrefix | default: config.etaText | default: 'Estimated Delivery:' %}
{% assign active_style = block.settings.style_preset | default: config.widgetStyle | default: config.presetStyle | default: 'capsule' %}
{% if active_style == 'bar' %}{% assign active_style = 'urgency' %}{% endif %}

{% comment %} Tag Rule Overrides {% endcomment %}
{% assign active_cutoff_hour = base_cutoff_hour %}
{% assign active_cutoff_minute = base_cutoff_minute %}
{% assign effective_lead_days = config.leadDays | default: 2 %}
{% assign rules = config.tagRules | default: config.tagRulesJson %}

{% if rules %}
  {% for rule in rules %}
    {% if product.tags contains rule.tag %}
      {% assign effective_lead_days = rule.leadDays %}
      {% if rule.cutoffHour %}{% assign active_cutoff_hour = rule.cutoffHour %}{% endif %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% assign current_country = localization.country.iso_code %}
{% assign is_available = product.selected_or_first_available_variant.available %}

<div 
  class="dropclock-root-wrapper dropclock-widget-root dc-w"
  id="dropclock-{{ block.id }}"
  data-dropclock-container
  data-cutoff-hour="{{ active_cutoff_hour }}"
  data-cutoff-min="{{ active_cutoff_minute }}"
  data-cutoff-minute="{{ active_cutoff_minute }}"
  data-lead-days="{{ effective_lead_days }}"
  data-working-days="{{ config.workingDays | default: '[1,2,3,4,5]' | escape }}"
  data-blackout-dates="{{ config.blackoutDates | json | escape }}"
  data-blackouts="{{ config.blackoutDates | json | escape }}"
  data-market-overrides="{{ config.marketOverrides | json | escape }}"
  data-timezone-offset="{{ tz_offset }}"
  data-tz-offset="{{ tz_offset }}"
  data-iana-tz="{{ iana_tz }}"
  data-current-country="{{ current_country }}"
  data-available="{{ is_available }}"
  data-widget-style="{{ active_style }}"
  data-translations='{{ trans | json | escape }}'
  data-lead-text="{{ lead_text | escape }}"
  data-sameday-text="{{ sameday_text | escape }}"
  data-nextday-text="{{ nextday_text | escape }}"
  data-eta-text="{{ eta_text | escape }}"
  style="
    --dc-primary: {{ block.settings.primary_color | default: config.accentColor | default: config.primaryColor | default: '#008060' }};
    --dc-bg: {{ block.settings.bg_color | default: config.cardBg | default: config.bgColor | default: '#f8fafc' }};
    --dc-text: {{ block.settings.text_color | default: config.textColor | default: '#0f172a' }};
    --dc-radius: {{ block.settings.border_radius | default: 12 }}px;
    min-height: 48px;
    display: flex;
    align-items: center;
    width: 100%;
    margin: {{ block.settings.margin_top | default: 12 }}px 0 {{ block.settings.margin_bottom | default: 12 }}px 0;
  "
>
  <div 
    class="dc-pill-card {{ active_style }} {% if block.settings.enable_shadow %}dc-shadow{% endif %}" 
    style="display: {% if is_available %}flex{% else %}none{% endif %}; border-radius: {{ block.settings.border_radius | default: 12 }}px;"
  >
    <div class="dc-primary-row">
      <div class="dc-pulse-indicator" aria-hidden="true">
        <span class="dc-ping"></span>
        <span class="dc-dot"></span>
      </div>
      <div class="dc-text-wrap">
        <span class="dc-label">{{ lead_text }}</span>
        <span class="dc-timer-val" data-dc-timer>--h --m --s</span>
        <span class="dc-subtext" data-dc-subtext>{{ sameday_text }}</span>
      </div>
    </div>
    
    {% if active_style == 'urgency' %}
      <div class="dc-bar-track">
        <div class="dc-bar-fill" data-dc-bar-fill style="width: 100%;"></div>
      </div>
    {% endif %}

    <div class="dc-secondary-row">
      {% if block.settings.show_icon %}
        <svg class="dc-truck-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="1" y="3" width="15" height="13"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
      {% endif %}
      <span class="dc-eta-label">{{ eta_text }}</span>
      <span class="dc-eta-date" data-dc-eta>Calculating...</span>
    </div>
  </div>

  <div 
    class="dc-backorder-notice" 
    style="display: {% if is_available %}none{% else %}flex{% endif %}; border-radius: {{ block.settings.border_radius | default: 12 }}px;"
  >
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span>Backorder Item: Ships as soon as restocked.</span>
  </div>
</div>

{% schema %}
{
  "name": "DropClock Delivery ETA",
  "target": "section",
  "stylesheet": "dropclock.css",
  "javascript": "dropclock.js",
  "settings": [
    {
      "type": "select",
      "id": "style_preset",
      "label": "Display Style",
      "options": [
        { "value": "capsule", "label": "21st.dev DTC Micro-Card (Recommended)" },
        { "value": "urgency", "label": "Urgency Highlight Bar" },
        { "value": "minimal", "label": "Minimal Text Line" }
      ],
      "default": "capsule"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Accent / Countdown Color",
      "default": "#008060"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Card Color",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Primary Text Color",
      "default": "#0f172a"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Top margin",
      "default": 12
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Bottom margin",
      "default": 12
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "enable_shadow",
      "label": "Enable soft elevation shadow",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show delivery truck icon",
      "default": true
    }
  ]
}
{% endschema %}
