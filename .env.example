# ==============================================================================
# DROPCLOCK ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Node Environment Mode ('development' | 'production')
NODE_ENV=development

# Shopify App Credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public App Tunnel / Production URL (No trailing slash)
SHOPIFY_APP_URL=https://dropclock.example.com

# Access Scopes
SCOPES=read_products,write_products

# Managed PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dropclock?schema=public

# Port
PORT=3000
